{
  "name": "@dv/text-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Text node component of DreamVerse: versioned Markdown documents of a project, addressed by a relative path, for planning text such as a script, story beats or an ad spec; textnode.write and textnode.edit store the next version, link it to the text nodes it was built from, and textnode.read reads one version or one section.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@dv/project": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@dv/asset-pool": "workspace:*",
    "@dv/ffmpeg": "workspace:*",
    "@types/node": "^22.20.0"
  }
}
