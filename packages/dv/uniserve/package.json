{
  "name": "@dv/uniserve",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Provider plugin uniserve of DreamVerse for models on UniServe servers: registers one dvModels entry per configured model (fasth3) and task (ref2v), with the fasth3 input and extra parameter schema, request validation and prompt skill, and renders each shot with one POST /v1/videos/sync.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@dv/asset-pool": "workspace:*",
    "@dv/fastvideo": "workspace:*",
    "@dv/ffmpeg": "workspace:*",
    "@dv/models": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@dv/project": "workspace:*",
    "@types/node": "^22.20.0"
  }
}
