{
  "name": "@dv/ui-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The DreamVerse canvas: the nodes of the registered node types drawn in one chrome and linked by asset flow, the dv.canvas Factory that the center view and the sidebar tab render, and the floating editor shell around each type's editor body.",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./contract": "./src/client/contract/index.ts",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@dv/ui-asset-pool": "workspace:*",
    "@dv/ui-kit": "workspace:*",
    "@dv/ui-media": "workspace:*",
    "@dv/ui-shell": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
