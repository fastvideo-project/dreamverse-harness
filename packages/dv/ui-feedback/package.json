{
  "name": "@dv/ui-feedback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DreamVerse Feedback button above Settings in the left sidebar: a dialog that sends a problem, suggestion or question, with the build and the open project, to the feedback sheet.",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@dv/feedback": "workspace:*",
    "@dv/ui-kit": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  }
}
