{
  "name": "@dv/shot-plan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shot plan component of DreamVerse: plan.create and plan.update store a plan of shots, each with the key of its model in the model catalog, and plan.approve schedules one shot.render per new or changed shot with the shot's model, and the timeline.create or timeline.update of their clips.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@dv/models": "workspace:*",
    "@dv/project": "workspace:*",
    "@dv/timeline": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@dv/asset-pool": "workspace:*",
    "@dv/ffmpeg": "workspace:*",
    "@types/node": "^22.20.0"
  }
}
