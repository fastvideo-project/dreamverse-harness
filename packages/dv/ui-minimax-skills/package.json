{
  "name": "@dv/ui-minimax-skills",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser half of the MiniMax skill set: nine template cards with preview GIFs on DreamVerse Home; a card click puts /name into the chat composer.",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-client-ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@dv/minimax-skills": "workspace:*",
    "@dv/ui-kit": "workspace:*",
    "@dv/ui-shell": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.0",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastvideo-project/dreamverse-harness.git",
    "directory": "packages/dv/ui-minimax-skills"
  }
}
