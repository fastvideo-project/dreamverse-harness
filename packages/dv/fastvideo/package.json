{
  "name": "@dv/fastvideo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Company plugin of DreamVerse for models on local FastVideo streaming_v2 servers: registers each configured model (fasth3) into dvModels with the modes the config gives a server for, plus the prompt skill of each model and mode.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@dreamverse/generation-client": "workspace:*",
    "@dv/models": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~",
    "@types/node": "^22.20.0"
  }
}
