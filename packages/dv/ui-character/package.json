{
  "name": "@dv/ui-character",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser half of the DreamVerse character component: the canvas node type, version kind, references in use, editor, @ menu kind and History row of the characters, declared with defineReferenceUi.",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@dv/ui-canvas": "workspace:*",
    "@dv/ui-composer": "workspace:*",
    "@dv/ui-history": "workspace:*",
    "@dv/ui-kit": "workspace:*",
    "@dv/ui-media": "workspace:*",
    "@dv/ui-reference-kit": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
