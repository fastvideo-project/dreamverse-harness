{
  "name": "@dv/timeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Timeline component of DreamVerse: the timelines of a project, their clips (assets with in and out points) and their sounds (audio assets on sound tracks), edited by the fourteen timeline.* edit operations, each clip named by its clip ID and each sound by its sound ID; editing a clip never creates a file, and timeline.export writes a timeline to one video with ffmpeg.",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-skill": "workspace:*",
    "@dv/asset-pool": "workspace:*",
    "@dv/canvas": "workspace:*",
    "@dv/ffmpeg": "workspace:*",
    "@dv/project": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@types/node": "^22.20.0"
  }
}
