{
  "name": "@dv/ui-shot-plan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser half of the DreamVerse shot plan: the canvas node type that draws each plan at its latest version with a frame grid of one slot per shot, the takes in use that keep the producers of a plan's reference assets on the canvas, and the plan editor with its versions, approval status and shots.",
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@dv/ui-canvas": "workspace:*",
    "@dv/ui-composer": "workspace:*",
    "@dv/ui-history": "workspace:*",
    "@dv/ui-kit": "workspace:*",
    "@dv/ui-media": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
