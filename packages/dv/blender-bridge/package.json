{
  "name": "@fastvideo/dreamverse-blender-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "Blender component of DreamVerse: the link that the DreamVerse add-on opens from the user's Blender to the harness, the agent tools that read the scene, run Python and look at the viewport, the render operations that put stills and animations into the project, and the routes that stream the viewport to the browser and serve the add-on.",
  "keywords": [
    "dreamverse-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastvideo-project/dreamverse-harness.git",
    "directory": "packages/dv/blender-bridge"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "addon/**/*.py",
    "addon/blender_manifest.toml",
    "README.md",
    "README.zh.md"
  ],
  "dependencies": {
    "fflate": "^0.8.3",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@dv/generation": "workspace:*",
    "@dv/project": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-credentials": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-util-values": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@dv/asset-pool": "workspace:*",
    "@dv/ffmpeg": "workspace:*",
    "@dv/generation": "workspace:*",
    "@dv/project": "workspace:*",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1"
  }
}
