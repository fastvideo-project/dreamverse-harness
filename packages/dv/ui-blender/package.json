{
  "name": "@fastvideo/dreamverse-ui-blender",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser half of the DreamVerse Blender component: a Blender right-Sidebar tab that shows how to connect the user's Blender with the DreamVerse add-on and then streams its viewport live, and the blender.render and blender.animation_render records as takes, declared with defineGenerationUi.",
  "keywords": [
    "dreamverse-plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fastvideo-project/dreamverse-harness.git",
    "directory": "packages/dv/ui-blender"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "publishConfig": {
    "access": "public",
    "main": "lib/index.js",
    "types": "lib/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./client": {
        "types": "./lib/types/client/index.d.ts",
        "default": "./lib/client.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "README.md",
    "README.zh.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-client-test-runtime": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-tool": "workspace:*",
    "@dv/ui-canvas": "workspace:*",
    "@dv/ui-composer": "workspace:*",
    "@dv/ui-generation": "workspace:*",
    "@dv/ui-history": "workspace:*",
    "@dv/ui-kit": "workspace:*",
    "@dv/ui-media": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
