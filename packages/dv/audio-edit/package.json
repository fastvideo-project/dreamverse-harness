{
  "name": "@dv/audio-edit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Audio edit component of DreamVerse: audioedit.split cuts an audio asset into pieces at given times or at its longest pauses, and audioedit.speed plays it faster or slower without changing its pitch, both with ffmpeg.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@dv/asset-pool": "workspace:*",
    "@dv/ffmpeg": "workspace:*",
    "@dv/project": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@types/node": "^22.20.0"
  }
}
