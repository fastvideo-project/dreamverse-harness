{
  "name": "@dv/workflow-story",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Workflow skills of DreamVerse: serves each skills/<name>/SKILL.md, such as story-directing and ad-making, through one FileSystemSkillProvider while the DSH skill registry is mounted.",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-skill": "workspace:*",
